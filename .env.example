# OpenAI API key. Keep this server-side; never put it in index.html.
OPENAI_API_KEY=your_api_key_here

# Current model used for packet classification and review.
OPENAI_MODEL=gpt-6-luna

# Port used by Replit/local development.
PORT=3000

# Maximum upload size in bytes (100 MB).
MAX_UPLOAD_BYTES=104857600
